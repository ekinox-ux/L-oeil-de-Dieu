API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# En-tetes Host acceptes par l'API (protection DNS rebinding).
OEIL_ALLOWED_HOSTS=127.0.0.1,localhost
OEIL_ALLOW_LOCALHOST_NO_AUTH=true
OEIL_INDEXES_CONFIG=backend/indexes.local.json
OEIL_CACHE_DIR=backend
OEIL_ALLOWED_ROOTS=
OEIL_MAX_QUERY_LENGTH=500
OEIL_MAX_SEARCH_OFFSET=10000
OEIL_MAX_TOP_EMAILS=100
OEIL_MAX_TOP_PHONES=50
OEIL_MAX_TOP_DOMAINS=30
# Plafonds des compteurs de classement de l'analyseur (les uniques restent exacts).
# Laisser vide, 0 ou une valeur negative applique le defaut.
OEIL_ANALYZER_MAX_EMAIL_ENTRIES=100000
OEIL_ANALYZER_MAX_PHONE_ENTRIES=50000
OEIL_ANALYZER_MAX_DOMAIN_ENTRIES=100000
OEIL_ANALYZER_SAVE_EVERY=100

# --- Breach lookup providers ---
HIBP_API_KEY=
BREACHDIRECTORY_RAPIDAPI_KEY=
BREACHDIRECTORY_RAPIDAPI_HOST=breachdirectory.p.rapidapi.com
OEIL_BREACH_LOOKUP_TIMEOUT=10
